{
  "backend": "sycl",
  "exe": "build_sycl/strata",
  "tokenizer": "../Strata-data/models/IQ3_S/pack/tokenizer",
  "host": "127.0.0.1",
  "port": 8080,
  "log": "strata-b580-02-new-defaults.log",
  "args": [
    "--pack", "../Strata-data/models/IQ3_S/pack",
    "--native", "../Strata-data/models/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "--ple-gguf", "../Strata-data/models/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00002-of-00002.gguf",
    "--expert-profile", "data/expert-profile-sycl.bin",
    "--mtp", "../Strata-data/mtp/rt",
    "--expert-cache", "1000",
    "--resident-experts",
    "--max-context", "131072",
    "--kv", "int8",
    "--kv-resident", "32768",
    "--prefill", "4096",
    "--spec", "4",
    "--spec-min-p", "0.5",
    "--spec-tree", "0",
    "--pool-workers", "26",
    "--ple-io", "ram",
    "--pcie-frac", "0.2",
    "--mtp-window", "8192"
  ],
  "env": {
    "ONEAPI_DEVICE_SELECTOR": "level_zero:0",
    "ZES_ENABLE_SYSMAN": "1",
    "SYCL_CACHE_PERSISTENT": "1",
    "NEO_CACHE_PERSISTENT": "1",
    "UR_L0_DEVICE_SCOPE_EVENTS": "2",
    "SYCL_PI_LEVEL_ZERO_DEVICE_SCOPE_EVENTS": "2",
    "STRATA_COPY_ENGINE": "1",
    "STRATA_PIN_DEBUG": "1",
    "STRATA_PARTIAL_PIN_GIB": "48",
    "STRATA_VERIFY_DEVICE_PLAN": "1",
    "STRATA_VERIFY_PROFILE": "1",
    "STRATA_PREFILL_TIMING": "1",
    "STRATA_DECODE_TIMING": "1",
    "STRATA_ATTN_MERGE_ACTIVE": "1",
    "STRATA_MMVQ_DECODE_256GRF": "0",
    "STRATA_B6_MMVQ_ROWS": "1",
    "STRATA_VERIFY_GRAPH": "split",
    "STRATA_VERIFY_GRAPH_CHUNK": "4",
    "STRATA_Q2_BITPLANE": "1",
    "STRATA_EXP_MODE": "0",
    "STRATA_IQ_DT_W": "11",
    "STRATA_MTP_SYCL_PRIO": "1",
    "STRATA_QSA_TOPK_WIDE_MIN": "7168",
    "STRATA_MMVF_ROWS": "0"
  }
}
